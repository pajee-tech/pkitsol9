{
  "name": "pkitsol-website",
  "version": "2.0.0",
  "private": true,
  "description": "PK IT Solutions marketing site: static HTML/CSS/JS, pre-rendered (SSG) and deployed on Vercel.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs dist 4173",
    "dev": "node scripts/serve.mjs . 8080",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "lighthouse": "lhci autorun",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
