{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs dist 4173",
      "url": ["http://localhost:4173/", "http://localhost:4173/seo-services", "http://localhost:4173/web-development", "http://localhost:4173/digital-marketing"],
      "numberOfRuns": 2,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
